{
  "name": "poke-jam",
  "version": "0.1.0",
  "description": "Draft a squad of Pokémon and play arcade 5v5 basketball.",
  "scripts": {
    "sprites": "node scripts/fetch-sprites.mjs",
    "predev": "npm run sprites",
    "dev": "vite",
    "prebuild": "npm run sprites",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kungFuDOOM/PokeBasketball.git"
  },
  "bugs": {
    "url": "https://github.com/kungFuDOOM/PokeBasketball/issues"
  },
  "homepage": "https://github.com/kungFuDOOM/PokeBasketball#readme",
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.1.12"
  },
  "private": true,
  "type": "module"
}
