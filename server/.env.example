# Copy to .env (Bun loads it automatically) and fill in. Never commit the real one.

# mainnet-beta or devnet. Devnet uses devnet USDC and Collector Crypt's devnet gacha.
CLUSTER=devnet
PORT=8787
DB_PATH=./data/pokejam.sqlite
# The game's URL(s), comma-separated, for CORS.
CLIENT_ORIGIN=https://kungfudoom.github.io

# A paid RPC (Helius, Triton, QuickNode...) is strongly recommended over the public one.
RPC_URL=https://api.devnet.solana.com

# House wallet: pays for prize pulls with the USDC players deposit. 64-byte secret key, as the JSON
# array in a Solana CLI keypair file or base58. Keep it in your host's secret manager.
HOUSE_SECRET_KEY=
# The house wallet's USDC token account (its associated token account for the USDC mint).
HOUSE_USDC_ACCOUNT=

# Collector Crypt gacha. Ask them for an API key so pulls are attributed to you.
CC_API_KEY=
# Pulls are bought and opened by the house after each draft (both players see the card before tip-off),
# then transferred to the winner. The house wallet needs USDC for pulls and some SOL for transfer fees.

# Comma-separated US state codes where paid battles are off (for example: WA,AZ). Empty = none.
RESTRICTED_REGIONS=

MIN_DEPOSIT_USD=5
MIN_WITHDRAWAL_USD=10
PICK_SECONDS=20
ACCEPT_TIMEOUT_SECONDS=180
FORFEIT_SECONDS=20
MAX_OPEN_BATTLES=3
DEPOSIT_POLL_SECONDS=15
DEPOSIT_COMMITMENT=finalized

# Bearer token for /api/admin/* (withdrawal approvals, manual credits, prize retries).
ADMIN_TOKEN=
